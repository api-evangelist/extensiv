{
  "opencollection": "1.0.0",
  "info": {
    "name": "Extensiv 3PL Warehouse Manager API (modeled) Authentication Customers API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List customers (endpointsModeled)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure-wms.com/customers",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List customers (endpointsModeled)"
        },
        {
          "info": {
            "name": "Retrieve a customer (endpointsModeled)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure-wms.com/customers/:customerId",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a customer (endpointsModeled)"
        }
      ]
    }
  ],
  "bundled": true
